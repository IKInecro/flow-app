<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes>
<attribute name="name" value="Factorial"/>
<attribute name="authors" value="MarcoFlow"/>
<attribute name="about" value="A recursive function that computes a factorial."/>
</attributes>
<function name="Main" type="None" variable="">
<parameters/>
<body>
<output expression="&quot;5! = &quot; &amp; Factorial(5)" newline="True"/>
</body>
</function>
<function name="Factorial" type="Integer" variable="result">
<parameters>
<parameter name="n" type="Integer" array="False"/>
</parameters>
<body>
<declare name="result" type="Integer" array="False" size=""/>
<if expression="n &lt;= 1">
<then>
<assign variable="result" expression="1"/>
</then>
<else>
<assign variable="result" expression="n * Factorial(n - 1)"/>
</else>
</if>
</body>
</function>
</flowgorithm>
