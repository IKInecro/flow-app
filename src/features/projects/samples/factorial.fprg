<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
<attributes>
<attribute name="name" value="Faktorial"/>
<attribute name="authors" value="MarcoFlow"/>
<attribute name="about" value="Fungsi rekursif untuk menghitung faktorial."/>
</attributes>
<function name="Main" type="None" variable="">
<parameters/>
<body>
<output expression="&quot;5! = &quot; &amp; Faktorial(5)" newline="True"/>
</body>
</function>
<function name="Faktorial" type="Integer" variable="hasil">
<parameters>
<parameter name="n" type="Integer" array="False"/>
</parameters>
<body>
<declare name="hasil" type="Integer" array="False" size=""/>
<if expression="n &lt;= 1">
<then>
<assign variable="hasil" expression="1"/>
</then>
<else>
<assign variable="hasil" expression="n * Faktorial(n - 1)"/>
</else>
</if>
</body>
</function>
</flowgorithm>
