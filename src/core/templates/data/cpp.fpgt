[Language]
name = C++
extension = cpp
call = {name}({args})
index = {name}[{index}]

[Types]
Integer = int
Real = double
String = string
Boolean = bool

[Literals]
line = "{value}"
true = true
false = false

[Operators]
plus = +
minus = -
times = *
divide = /
modulo = %
power = ^
concat = +
gt = >
lt = <
gte = >=
lte = <=
eq = ==
neq = !=
and = &&
or = ||
not = !

[Program]
line = #include <iostream>
line = #include <string>
line = using namespace std;
line = {functions}
line = {main}

[Main]
line = int main() {
indent
line = {body}
line = return 0;
dedent
line = }

[Declare]
array line = {type} {names}[{size}];
~array line = {type} {names} = {zero};

[Assign]
line = {target} = {expression};

[Input]
line = cin >> {variable};

[Output]
line = cout << {expression} << endl;

[If]
line = if ({condition}) {
indent
line = {then}
dedent
line = }
else line = else {
else indent
else line = {else}
else dedent
else line = }

[While]
line = while ({condition}) {
indent
line = {body}
dedent
line = }

[Do]
line = do {
indent
line = {body}
dedent
line = } while ({condition});

[For]
~step dec line = for ({variable} = {start}; {variable} >= {end}; {variable} -= {step}) {
~step ~dec line = for ({variable} = {start}; {variable} <= {end}; {variable} += {step}) {
step dec line = for ({variable} = {start}; {variable} >= {end}; {variable}--) {
step ~dec line = for ({variable} = {start}; {variable} <= {end}; {variable}++) {
indent
line = {body}
dedent
line = }

[Call]
line = {function}({args});

[Comment]
line = // {text}

[Breakpoint]
line = // breakpoint

[Function]
line = {returnType} {name}({params}) {
indent
line = {body}
returns line = return {returnName};
dedent
line = }

[Param]
line = {type} {name}{arraySuffix}
