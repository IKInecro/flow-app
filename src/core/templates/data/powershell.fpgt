[Language]
name = PowerShell
extension = ps1
call = {name}({args})
index = {name}[{index}]
variable = ${name}

[Types]
Integer = int
Real = float
String = str
Boolean = bool

[Literals]
line = "{value}"
true = $true
false = $false

[Operators]
plus = +
minus = -
times = *
divide = /
modulo = %
power = *
concat = +
gt = -gt
lt = -lt
gte = -ge
lte = -le
eq = -eq
neq = -ne
and = -and
or = -or
not = -not

[Program]
line = {functions}
line = {main}

[Main]
line = {body}

[Declare]
array line = {names} = @({zero}) * {size}
~array line = {names} = {zero}

[Assign]
line = {target} = {expression}

[Input]
line = {variable} = Read-Host

[Output]
line = Write-Output {expression}

[If]
line = if ({condition}) {
indent
line = {then}
dedent
line = }
else line = else {
else indent
else line = {else}
else dedent
else line = }

[While]
line = while ({condition}) {
indent
line = {body}
dedent
line = }

[Do]
line = do {
indent
line = {body}
dedent
line = } while ({condition})

[For]
line = for ({variable} = {start}; {variable} -le {end}; {variable} += {step}) {
indent
line = {body}
dedent
line = }

[Call]
line = {function} {args}

[Comment]
line = # {text}

[Breakpoint]
line = # breakpoint

[Function]
line = function {name} {
indent
line = param({params})
line = {body}
returns line = return {returnName}
dedent
line = }

[Param]
line = {name}
