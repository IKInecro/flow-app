[Language]
name = Swift
extension = swift
call = {name}({args})
index = {name}[{index}]

[Types]
Integer = Int
Real = Double
String = String
Boolean = Bool

[Literals]
line = "{value}"
true = true
false = false

[Operators]
plus = +
minus = -
times = *
divide = /
modulo = %
power = ^
concat = +
gt = >
lt = <
gte = >=
lte = <=
eq = ==
neq = !=
and = &&
or = ||
not = !

[Program]
line = {functions}
line = {main}

[Main]
line = {body}

[Declare]
array line = var {names} = [{type}](repeating: {zero}, count: {size})
~array line = var {names}: {type} = {zero}

[Assign]
line = {target} = {expression}

[Input]
line = {variable} = Int(readLine()!)!

[Output]
line = print({expression})

[If]
line = if ({condition}) {
indent
line = {then}
dedent
line = }
else line = else {
else indent
else line = {else}
else dedent
else line = }

[While]
line = while ({condition}) {
indent
line = {body}
dedent
line = }

[Do]
line = do {
indent
line = {body}
dedent
line = } while ({condition});

[For]
~step dec line = for {variable} in stride(from: {start}, through: {end}, by: -{step}) {
~step ~dec line = for {variable} in stride(from: {start}, through: {end}, by: {step}) {
step dec line = for {variable} in stride(from: {start}, through: {end}, by: -1) {
step ~dec line = for {variable} in stride(from: {start}, through: {end}, by: 1) {
indent
line = {body}
dedent
line = }

[Call]
line = {function}({args})

[Comment]
line = // {text}

[Breakpoint]
line = // breakpoint

[Function]
line = func {name}({params}) -> {returnType} {
indent
line = {body}
returns line = return {returnName}
dedent
line = }

[Param]
line = {name}: {type}
