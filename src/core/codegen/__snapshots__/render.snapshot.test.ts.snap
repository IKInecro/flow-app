exports[`cpp renders the arrays sample 1`] = `
"#include <iostream>
#include <string>
using namespace std;
int main() {
  int a[3];
  int i = 0;
  for (i = 0; i <= 2; i++) {
    a[i] = i * 2;
    cout << a[i] << endl;
  }
  return 0;
}
"
`;

exports[`cpp renders the factorial sample 1`] = `
"#include <iostream>
#include <string>
using namespace std;
int Factorial(int n) {
  int result = 0;
  if (n <= 1) {
    result = 1;
  }
  else {
    result = n * Factorial(n - 1);
  }
  return result;
}
int main() {
  cout << Factorial(5) << endl;
  return 0;
}
"
`;

exports[`java renders the arrays sample 1`] = `
